#!/usr/bin/env sh
# Conventional Commits doğrulayıcı

first_line=$(head -n1 "$1")

# Merge commit'lerine karışmıyoruz
case "$first_line" in
  Merge\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'

if ! echo "$first_line" | grep -Eq "$pattern"; then
  echo "HATA: Commit mesajı Conventional Commits formatına uymuyor." >&2
  echo "Beklenen: tip(kapsam): açıklama   Örnek: feat(catalog): add pagination" >&2
  exit 1
fi
